# Example environment for local runs and for the deployed function.
#
# Committed as a template only. Copy to .env.local (git-ignored) and edit there.
# Nothing secret belongs in this file: Amazon SES and SSM access use the caller's
# role or profile, and the recipient list lives in SSM Parameter Store
# (docs/addenda/0004-configuration-via-ssm-parameters.md).

# Where configuration and state live in SSM Parameter Store.
SSM_CONFIG_PATH=/sap-security-patch-day/
SSM_STATE_PATH=/sap-security-patch-day/state/

# SES configuration set created by the deployment.
CONFIGURATION_SET=sap-security-patch-day

# The retry window ends at this Singapore-time boundary; the attempt at or after
# it is the "final attempt" that sends a pending notice (spec FR-3.4).
RETRY_WINDOW_END_SGT=20:00

# Transport policy.
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_ATTEMPTS=3
HTTP_BACKOFF_SECONDS=2
USER_AGENT=sap-patch-day-notifier/1 (aws-lambda; +https://support.sap.com)

# Set to true to exercise the whole pipeline without sending email and without
# writing state: the mailer logs, the state store becomes read-only.
DRY_RUN=false
LOG_LEVEL=INFO
